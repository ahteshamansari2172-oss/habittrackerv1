function safeAlert(title, message) {
  try {
    SpreadsheetApp.getUi().alert(title, message, SpreadsheetApp.getUi().ButtonSet.OK);
  } catch(e) {
    Logger.log('✅ ' + title + ' | ' + message);
  }
}

function safeConfirm(title, message) {
  try {
    return SpreadsheetApp.getUi().alert(title, message, SpreadsheetApp.getUi().ButtonSet.YES_NO);
  } catch(e) {
    Logger.log('⚠️ Auto-confirmed: ' + title);
    return SpreadsheetApp.getUi().Button.YES;
  }
}

