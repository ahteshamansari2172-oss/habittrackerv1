// ═════════════════════════════════════════════════════════════════════════════
// FORMULA PROTECTION
// ═════════════════════════════════════════════════════════════════════════════
function protectHabitFormulas(ss) {
  const tracker = ss.getSheetByName('Habit Tracker');
  if (!tracker) return;

  const days = CONFIG.DAYS_TO_TRACK;
  const protectedRanges = [
    { col: days + 2, name: 'Current Streak' },
    { col: days + 3, name: 'Longest Streak' },
    { col: days + 4, name: 'Total Done' },
    { col: days + 5, name: 'Completion %' }
  ];

  for (let i = 0; i < protectedRanges.length; i++) {
    try {
      const range = tracker.getRange(2, protectedRanges[i].col, 100, 1);
      const protection = range.protect().setDescription(protectedRanges[i].name + ' formula');
      const editors = protection.getEditors();
      for (let j = 0; j < editors.length; j++) {
        protection.removeEditor(editors[j]);
      }
    } catch (e) {
      Logger.log('Protection error for ' + protectedRanges[i].name + ': ' + e);
    }
  }
}

// ═════════════════════════════════════════════════════════════════════════════
// UTILITY: Get column letter from number (1=A, 2=B, etc.)
// ═════════════════════════════════════════════════════════════════════════════
function getColumnLetter(column) {
  let temp, letter = '';
  while (column > 0) {
    temp = (column - 1) % 26;
    letter = String.fromCharCode(temp + 65) + letter;
    column = (column - temp - 1) / 26;
  }
  return letter;
}

