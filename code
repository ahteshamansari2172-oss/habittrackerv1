/**
 * Count current streak — consecutive TRUE values from rightmost (today) backwards
 * Usage: =CURRENTSTREAK(B2:AE2)
 */
function CURRENTSTREAK(range) {
  var values = range.getValues()[0];
  var streak = 0;
  for (var i = values.length - 1; i >= 0; i--) {
    if (values[i] === true) {
      streak++;
    } else {
      break;
    }
  }
  return streak;
}

/**
 * Count longest streak — maximum consecutive TRUE values in range
 * Usage: =LONGESTSTREAK(B2:AE2)
 */
function LONGESTSTREAK(range) {
  var values = range.getValues()[0];
  var maxStreak = 0;
  var current = 0;
  for (var i = 0; i < values.length; i++) {
    if (values[i] === true) {
      current++;
      if (current > maxStreak) maxStreak = current;
    } else {
      current = 0;
    }
  }
  return maxStreak;
}

// ═════════════════════════════════════════════════════════════════════════════
// MAIN SETUP FUNCTION
// ═════════════════════════════════════════════════════════════════════════════
function setupHabitTracker() {
  try {
    let ss = SpreadsheetApp.getActiveSpreadsheet();
    if (!ss) {
      ss = SpreadsheetApp.create(CONFIG.SHEET_NAME);
      Logger.log('Created new spreadsheet: ' + ss.getUrl());
    }
    if (ss.getName() !== CONFIG.SHEET_NAME) {
      ss.rename(CONFIG.SHEET_NAME);
    }

    const buildSteps = [
      { name: 'Habit Tracker', builder: buildTrackerTab },
      { name: 'Dashboard', builder: buildDashboardTab },
      { name: 'Settings', builder: buildSettingsTab }
    ];

    for (let i = 0; i < buildSteps.length; i++) {
      try {
        buildSteps[i].builder(ss);
        Logger.log('✓ Built: ' + buildSteps[i].name);
      } catch (stepError) {
        Logger.log('✗ Error building ' + buildSteps[i].name + ': ' + stepError);
        try {
          buildSteps[i].builder(ss);
          Logger.log('✓ Recovered: ' + buildSteps[i].name);
        } catch (backupError) {
          Logger.log('✗ Backup failed: ' + backupError);
        }
      }
    }

    // Apply conditional formatting
    try {
      applyStreakFormatting(ss);
      Logger.log('✓ Conditional formatting applied');
    } catch (cfError) {
      Logger.log('✗ CF error: ' + cfError);
      try {
        applyStreakFormatting(ss);
      } catch (retryError) {
        Logger.log('✗ CF retry failed: ' + retryError);
      }
    }

    // Add sample data
    try {
      addSampleHabits(ss);
      Logger.log('✓ Sample habits added');
    } catch (sampleError) {
      Logger.log('✗ Sample error: ' + sampleError);
    }

    // Protect formula ranges
    try {
      protectHabitFormulas(ss);
      Logger.log('✓ Formula protection applied');
    } catch (protectError) {
      Logger.log('✗ Protection error: ' + protectError);
    }

    safeAlert(
      '✅ Habit Streak Counter Built Successfully!',
      'Your Habit Tracker is ready.\n\n' +
      'What you got:\n' +
      '• 30-day rolling tracker with checkboxes\n' +
      '• Current streak auto-counts (break = RED)\n' +
      '• Longest streak tracker\n' +
      '• Total completions + completion %\n' +
      '• Dashboard with charts\n\n' +
      'Start checking habits in the Habit Tracker tab!'
    );

  } catch (mainError) {
    Logger.log('CRITICAL ERROR: ' + mainError);
    safeAlert('❌ Setup Error', 'Something went wrong: ' + mainError + '\n\nCheck execution log (View → Logs) and try again.');
  }
}

