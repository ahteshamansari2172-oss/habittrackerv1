// TAB BUILDER: Habit Tracker (main tracking sheet)
// ═════════════════════════════════════════════════════════════════════════════
function buildTrackerTab(ss) {
  let sheet = ss.getSheetByName('Habit Tracker');
  if (!sheet) {
    sheet = ss.insertSheet('Habit Tracker');
  } else {
    sheet.clear();
  }

  const days = CONFIG.DAYS_TO_TRACK; // 30
  const habits = CONFIG.DEFAULT_HABITS.length; // 10

  // Row 1: Date headers
  sheet.getRange(1, 1).setValue('Habit').setFontWeight('bold').setBackground(CONFIG.COLORS.header).setFontColor('white');

  // Generate date formulas for 30 days (B1 to AE1)
  // B1 = TODAY()-29, C1 = TODAY()-28, ..., AE1 = TODAY()
  for (let d = 0; d < days; d++) {
    const col = d + 2; // Column B = 2
    const dateOffset = days - 1 - d; // 29, 28, ..., 0
    const cell = sheet.getRange(1, col);
    cell.setFormula('=TEXT(TODAY()-' + dateOffset + ',"ddd dd")');
    cell.setFontWeight('bold').setBackground(CONFIG.COLORS.header).setFontColor('white');
    cell.setHorizontalAlignment('center');
  }

  // Stats headers (AF, AG, AH, AI)
  const statCols = [
    { col: days + 2, label: 'Current Streak', color: CONFIG.COLORS.streakHeader },
    { col: days + 3, label: 'Longest Streak', color: CONFIG.COLORS.statHeader },
    { col: days + 4, label: 'Total Done', color: CONFIG.COLORS.statHeader },
    { col: days + 5, label: 'Completion %', color: CONFIG.COLORS.statHeader }
  ];

  for (let i = 0; i < statCols.length; i++) {
    const sc = statCols[i];
    sheet.getRange(1, sc.col).setValue(sc.label)
      .setFontWeight('bold')
      .setBackground(sc.color)
      .setFontColor('white')
      .setHorizontalAlignment('center');
  }

  // Habit names (Column A, rows 2-11)
  for (let h = 0; h < habits; h++) {
    sheet.getRange(h + 2, 1).setValue(CONFIG.DEFAULT_HABITS[h]).setFontWeight('bold');
  }

  // Insert checkboxes for all daily cells (B2:AE11)
  const checkboxRange = sheet.getRange(2, 2, habits, days);
  checkboxRange.insertCheckboxes();
  checkboxRange.setHorizontalAlignment('center');

  // Stats formulas for each habit row
  const dailyRangeRef = 'B2:AE2'; // Will be adjusted per row by the script
  const dailyRangeRefLetters = getColumnLetter(2) + '2:' + getColumnLetter(days + 1) + '2';

  for (let h = 0; h < habits; h++) {
    const row = h + 2;
    const dailyRef = 'B' + row + ':AE' + row;

    // Current Streak (AF) — uses custom function
    sheet.getRange(row, days + 2).setFormula('=IFERROR(CURRENTSTREAK(' + dailyRef + '),0)');
    sheet.getRange(row, days + 2).setFontWeight('bold').setHorizontalAlignment('center');

    // Longest Streak (AG) — uses custom function
    sheet.getRange(row, days + 3).setFormula('=IFERROR(LONGESTSTREAK(' + dailyRef + '),0)');
    sheet.getRange(row, days + 3).setHorizontalAlignment('center');

    // Total Done (AH) — COUNTIF
    sheet.getRange(row, days + 4).setFormula('=COUNTIF(' + dailyRef + ',TRUE)');
    sheet.getRange(row, days + 4).setHorizontalAlignment('center');

    // Completion % (AI)
    sheet.getRange(row, days + 5).setFormula('=IFERROR(' + getColumnLetter(days + 4) + row + '/' + days + ',0)');
    sheet.getRange(row, days + 5).setNumberFormat('0"%"');
    sheet.getRange(row, days + 5).setHorizontalAlignment('center');
  }

  // Backup formulas (hidden columns AK-AN)
  const backupStartCol = days + 7; // AK
  sheet.getRange(1, backupStartCol).setValue('BKUP_STREAK').setFontWeight('bold').setBackground('#EA4335').setFontColor('white');
  sheet.getRange(1, backupStartCol + 1).setValue('BKUP_LONGEST').setFontWeight('bold').setBackground('#EA4335').setFontColor('white');
  sheet.getRange(1, backupStartCol + 2).setValue('BKUP_TOTAL').setFontWeight('bold').setBackground('#EA4335').setFontColor('white');
  sheet.getRange(1, backupStartCol + 3).setValue('BKUP_PCT').setFontWeight('bold').setBackground('#EA4335').setFontColor('white');

  for (let h = 0; h < habits; h++) {
    const row = h + 2;
    const dailyRef = 'B' + row + ':AE' + row;
    sheet.getRange(row, backupStartCol).setFormula('=IFERROR(CURRENTSTREAK(' + dailyRef + '),0)');
    sheet.getRange(row, backupStartCol + 1).setFormula('=IFERROR(LONGESTSTREAK(' + dailyRef + '),0)');
    sheet.getRange(row, backupStartCol + 2).setFormula('=COUNTIF(' + dailyRef + ',TRUE)');
    sheet.getRange(row, backupStartCol + 3).setFormula('=IFERROR(' + getColumnLetter(backupStartCol + 2) + row + '/' + days + ',0)');
  }
  sheet.hideColumns(backupStartCol, 4);

  // Freeze header row and habit column
  sheet.setFrozenRows(1);
  sheet.setFrozenColumns(1);

  // Column widths
  sheet.setColumnWidth(1, 150);
  for (let d = 0; d < days; d++) {
    sheet.setColumnWidth(d + 2, 45);
  }
  for (let i = 0; i < statCols.length; i++) {
    sheet.setColumnWidth(statCols[i].col, 110);
  }

  // Add helper note
  sheet.getRange(habits + 3, 1).setValue('💡 Check the box when you complete the habit. Streak auto-counts. Break it → RED.').setFontStyle('italic');
}

