// ═════════════════════════════════════════════════════════════════════════════
// CONDITIONAL FORMATTING
// ═════════════════════════════════════════════════════════════════════════════
function applyStreakFormatting(ss) {
  const tracker = ss.getSheetByName('Habit Tracker');
  if (!tracker) return;

  const days = CONFIG.DAYS_TO_TRACK;
  const habits = CONFIG.DEFAULT_HABITS.length;

  // Clear existing rules
  tracker.setConditionalFormatRules([]);
  const rules = [];

  // Rule 1: Daily checkbox TRUE → Green
  const checkedRule = SpreadsheetApp.newConditionalFormatRule()
    .whenCheckboxChecked()
    .setBackground('#D4EDDA')
    .setFontColor('#155724')
    .setRanges([tracker.getRange(2, 2, habits, days)])
    .build();
  rules.push(checkedRule);

  // Rule 2: Daily checkbox FALSE → Light gray (subtle)
  const uncheckedRule = SpreadsheetApp.newConditionalFormatRule()
    .whenCheckboxUnchecked()
    .setBackground('#F8F9FA')
    .setFontColor('#6C757D')
    .setRanges([tracker.getRange(2, 2, habits, days)])
    .build();
  rules.push(uncheckedRule);

  // Rule 3: Current Streak = 0 → RED (BROKEN)
  const streakBrokenRule = SpreadsheetApp.newConditionalFormatRule()
    .whenNumberEqualTo(0)
    .setBackground('#F8D7DA')
    .setFontColor('#721C24')
    .setBold(true)
    .setRanges([tracker.getRange(2, days + 2, habits, 1)])
    .build();
  rules.push(streakBrokenRule);

  // Rule 4: Current Streak > 0 → GREEN (ACTIVE)
  const streakActiveRule = SpreadsheetApp.newConditionalFormatRule()
    .whenNumberGreaterThan(0)
    .setBackground('#D4EDDA')
    .setFontColor('#155724')
    .setBold(true)
    .setRanges([tracker.getRange(2, days + 2, habits, 1)])
    .build();
  rules.push(streakActiveRule);

  // Rule 5: Completion % color scale
  const pctScaleRule = SpreadsheetApp.newConditionalFormatRule()
    .setGradientMinpoint('#F8D7DA')
    .setGradientMidpoint('#FFF3CD')
    .setGradientMaxpoint('#D4EDDA')
    .setRanges([tracker.getRange(2, days + 5, habits, 1)])
    .build();
  rules.push(pctScaleRule);

  // Rule 6: Longest Streak highlight (top performer)
  const longestHighlightRule = SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied('=AG2=MAX($AG$2:$AG$11)')
    .setBackground('#FFF3CD')
    .setFontColor('#856404')
    .setBold(true)
    .setRanges([tracker.getRange(2, days + 3, habits, 1)])
    .build();
  rules.push(longestHighlightRule);

  tracker.setConditionalFormatRules(rules);
}

